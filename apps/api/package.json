{
  "name": "@surge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "agent:setup": "tsx --env-file=../../.env agent/setup.ts",
    "eval:triage": "tsx --env-file=../../.env eval/triage.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^1.13.7",
    "@surge/shared": "workspace:*",
    "hono": "^4.6.16",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
