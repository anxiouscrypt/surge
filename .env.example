# Copy to .env (never commit real keys)

# --- API ---
PORT=8787
# Public HTTPS URL of the API (tunnel or Vultr). ElevenLabs tools call this.
PUBLIC_BASE_URL=http://localhost:8787
# Shared secret the ElevenLabs server tools send in the X-Surge-Secret header
TOOL_SECRET=change-me
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: voice for the agent (defaults to the ElevenLabs default voice)
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Twilio: number imported into ElevenLabs; creds also used to hand live calls to a dispatcher
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Phone that rings when a dispatcher clicks "Take over" (E.164, e.g. +17345550100)
DISPATCHER_PHONE=
GEMINI_API_KEY=
MONGODB_URI=
TIGER_DATABASE_URL=
FIRMS_MAP_KEY=
# Brev classifier endpoint (optional)
CLASSIFIER_URL=
# Dispatch area bias for geocoding: west,south,east,north (Washtenaw County)
DISPATCH_BBOX=-84.13,42.07,-83.54,42.43

# --- Web (Vite exposes only VITE_*) ---
VITE_API_URL=http://localhost:8787
VITE_MAPBOX_TOKEN=
