# Copy to .env (never commit real keys)

# --- API ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# Shared secret the ElevenLabs server tools send in the X-Surge-Secret header
TOOL_SECRET=change-me
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
GEMINI_API_KEY=
MONGODB_URI=
TIGER_DATABASE_URL=
FIRMS_MAP_KEY=
# Brev classifier endpoint (optional)
CLASSIFIER_URL=
# Dispatch area bias for geocoding: west,south,east,north (Washtenaw County)
DISPATCH_BBOX=-84.13,42.07,-83.54,42.43

# --- Web (Vite exposes only VITE_*) ---
VITE_API_URL=http://localhost:8787
VITE_MAPBOX_TOKEN=
