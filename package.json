{
  "name": "surge",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @surge/api dev",
    "dev:web": "pnpm --filter @surge/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "agent:setup": "pnpm --filter @surge/api agent:setup",
    "demo": "node scripts/demo.mjs"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
